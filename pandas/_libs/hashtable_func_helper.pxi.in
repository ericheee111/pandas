@cython.wraparound(False)
@cython.boundscheck(False)
cpdef ismember_float64_zero_range(
    const float64_t[::1] arr, Py_ssize_t upper
):
    cdef:
        Py_ssize_t i, n = len(arr)
        float64_t val
        ndarray[uint8_t] result = np.empty(n, dtype=np.uint8)

    with nogil:
        for i in range(n):
            val = arr[i]
            result[i] = (
                val >= 0.0
                and val < upper
                and val == <int64_t>val
            )

    return result.view(np.bool_)


@cython.wraparound(False)
@cython.boundscheck(False)
cpdef unique_float64_monotonic(const float64_t[::1] values):
    cdef:
        Py_ssize_t i, n = len(values), count = 1
        float64_t val, previous
        bint valid = True
        ndarray[float64_t] result

    if n == 0:
        return np.empty(0, dtype=np.float64)

    result = np.empty(n, dtype=np.float64)
    previous = values[0]
    if previous != previous:
        return None
    result[0] = previous

    with nogil:
        for i in range(1, n):
            val = values[i]
            if val != val:
                valid = False
                break
            if are_equivalent_float64_t(val, previous):
                continue
            if val < previous:
                valid = False
                break

            result[count] = val
            count += 1
            previous = val

            # Leave dense runs to the regular hash-table path.
            if i >= 4096 and count * 4 > i + 1:
                valid = False
                break

    if not valid:
        return None
    return result[:count].copy()


@cython.wraparound(False)
@cython.boundscheck(False)
cpdef factorize_float64_monotonic(const float64_t[::1] values):
    cdef:
        Py_ssize_t i, n = len(values), count = 1
        float64_t val, previous
        bint valid = True
        ndarray[intp_t] labels = np.empty(n, dtype=np.intp)
        ndarray[float64_t] uniques

    if n == 0:
        return labels, np.empty(0, dtype=np.float64)

    uniques = np.empty(n, dtype=np.float64)
    previous = values[0]
    if previous != previous:
        return None
    labels[0] = 0
    uniques[0] = previous

    with nogil:
        for i in range(1, n):
            val = values[i]
            if val != val:
                valid = False
                break
            if are_equivalent_float64_t(val, previous):
                labels[i] = count - 1
                continue
            if val < previous:
                valid = False
                break

            labels[i] = count
            uniques[count] = val
            count += 1
            previous = val

            # Leave dense runs to the regular hash-table path.
            if i >= 4096 and count * 4 > i + 1:
                valid = False
                break

    if not valid:
        return None
    return labels, uniques[:count].copy()


# ---------------------------------------------------------------------------
# Dense-range int64 factorization fast path.
#
# When an int64 array's value span (max - min + 1) is small relative to its
# length, factorization can be done with a single bitmap scan instead of
# hash-table insertion.  This produces *sorted* uniques directly, so the
# caller can skip ``safe_sort`` for ``sort=True``.
#
# Returns ``(codes: intp[n], uniques: int64[count])`` with uniques sorted
# ascending, or ``None`` to fall back to the regular hashtable path.
#
# The thresholds below are conservative safety caps, not benchmark
# parameters.  They are duplicated in ``algorithms.py`` only as the Python
# pre-screen; the authoritative copy lives here (the Cython kernel is the
# final arbiter and may still return ``None``).
# ---------------------------------------------------------------------------

@cython.wraparound(False)
@cython.boundscheck(False)
cpdef factorize_int64_dense_range(const int64_t[::1] values):
    # Conservative safety caps (see module docstring above).  These are
    # *not* benchmark parameters: any int64 array that satisfies them
    # benefits, regardless of its origin.
    cdef Py_ssize_t min_len = 100_000
    cdef uint64_t max_span = <uint64_t>1 << 20      # 1,048,576
    cdef Py_ssize_t density_ratio = 8

    cdef:
        Py_ssize_t i, n = len(values)
        Py_ssize_t offset, span_sz, count = 0
        int64_t vmin, vmax, v
        uint64_t umin, umax, span, uoff
        ndarray[uint8_t] bitmap
        ndarray[intp_t] codes
        ndarray[int64_t] uniques
        ndarray[intp_t] code_map
        uint8_t[::1] bm
        intp_t[::1] cd
        intp_t[::1] cm
        int64_t[::1] un

    # Short inputs: leave to the hashtable (overhead not worthwhile).
    if n < min_len:
        return None

    # --- Pass 1: min/max (nogil, pure int64 arithmetic) -----------------
    vmin = values[0]
    vmax = values[0]
    with nogil:
        for i in range(1, n):
            v = values[i]
            if v < vmin:
                vmin = v
            elif v > vmax:
                vmax = v

    # --- Span check (overflow-safe via unsigned arithmetic) -------------
    # Cast to uint64 so that ``umax - umin`` never overflows int64.
    umin = <uint64_t>vmin
    umax = <uint64_t>vmax
    span = umax - umin                       # safe: umax >= umin

    if span > max_span:
        return None
    # Reject sparse ranges: span must be at most ``ratio * n``.
    if span + 1 > <uint64_t>(n * density_ratio):
        return None

    # --- Allocation (GIL held) ------------------------------------------
    span_sz = <Py_ssize_t>span + 1
    bitmap = np.zeros((span_sz + 7) // 8, dtype=np.uint8)
    codes = np.empty(n, dtype=np.intp)
    uniques = np.empty(span_sz, dtype=np.int64)
    code_map = np.empty(span_sz, dtype=np.intp)
    bm = bitmap
    cd = codes
    un = uniques
    cm = code_map

    # --- Pass 2: mark bitmap + write tentative codes (nogil) ------------
    with nogil:
        for i in range(n):
            v = values[i]
            uoff = <uint64_t>v - umin        # safe: umin <= v <= umax
            cd[i] = <intp_t>uoff             # tentative code == offset
            bm[uoff >> 3] |= <uint8_t>(1 << (uoff & 7))

    # --- Pass 3: bitmap scan → code_map + sorted uniques (nogil) --------
    with nogil:
        for offset in range(span_sz):
            if bm[offset >> 3] & (<uint8_t>1 << (offset & 7)):
                cm[offset] = count
                un[count] = <int64_t>(umin + <uint64_t>offset)
                count += 1
            else:
                cm[offset] = -1              # gap: value absent

    # --- Pass 4: remap tentative codes (nogil) --------------------------
    with nogil:
        for i in range(n):
            cd[i] = cm[cd[i]]

    return codes, uniques[:count].copy()


{{for dtype, c_type in [('float64', 'float64_t'), ('int64', 'int64_t')]}}

@cython.wraparound(False)
@cython.boundscheck(False)
cpdef unique_{{dtype}}_masked_monotonic_tail(
    const {{c_type}}[::1] values, const uint8_t[::1] mask
):
    cdef:
        Py_ssize_t i, j, n = len(values), suffix_start = 0
        Py_ssize_t count = 0, prefix_count
        {{c_type}} val, previous, prefix_max
        bint have_previous = False, have_prefix_max = False
        bint seen_na = False, duplicate, valid = True
        ndarray[{{c_type}}] result = np.empty(n, dtype=np.{{dtype}})
        ndarray[uint8_t] result_mask = np.empty(n, dtype=np.uint8)

    if n != len(mask):
        raise ValueError("values and mask must have the same length")

    with nogil:
        for i in range(n):
            if mask[i]:
                continue

            val = values[i]
            {{if dtype == 'float64'}}
            if val != val:
                valid = False
                break
            {{endif}}
            if have_previous and val < previous:
                suffix_start = i
                if suffix_start > 64:
                    valid = False
                    break
            previous = val
            have_previous = True

        have_previous = False

    # Keep the prefix scan bounded; larger disordered inputs use the hash table.
    if not valid:
        return None

    with nogil:
        for i in range(suffix_start):
            if mask[i]:
                if not seen_na:
                    result[count] = values[i]
                    result_mask[count] = 1
                    count += 1
                    seen_na = True
                continue

            val = values[i]
            {{if dtype == 'float64'}}
            if val != val:
                valid = False
                break
            {{endif}}
            duplicate = False
            for j in range(count):
                if result_mask[j]:
                    continue
                {{if dtype == 'float64'}}
                if are_equivalent_float64_t(val, result[j]):
                {{else}}
                if val == result[j]:
                {{endif}}
                    duplicate = True
                    break

            if not duplicate:
                result[count] = val
                result_mask[count] = 0
                count += 1
                if not have_prefix_max or val > prefix_max:
                    prefix_max = val
                    have_prefix_max = True

        prefix_count = count
        for i in range(suffix_start, n):
            if mask[i]:
                if not seen_na:
                    result[count] = values[i]
                    result_mask[count] = 1
                    count += 1
                    seen_na = True
                continue

            val = values[i]
            if have_previous:
                {{if dtype == 'float64'}}
                if are_equivalent_float64_t(val, previous):
                {{else}}
                if val == previous:
                {{endif}}
                    continue
            previous = val
            have_previous = True

            duplicate = False
            if have_prefix_max and val <= prefix_max:
                for j in range(prefix_count):
                    if result_mask[j]:
                        continue
                    {{if dtype == 'float64'}}
                    if are_equivalent_float64_t(val, result[j]):
                    {{else}}
                    if val == result[j]:
                    {{endif}}
                        duplicate = True
                        break

            if not duplicate:
                result[count] = val
                result_mask[count] = 0
                count += 1

    if not valid:
        return None
    return result[:count].copy(), result_mask[:count].copy().view(np.bool_)


{{endfor}}


ctypedef fused htfunc_t:
    numeric_object_t
    complex128_t
    complex64_t


cpdef value_count(ndarray[htfunc_t] values, bint dropna, const uint8_t[:] mask=None):
    if htfunc_t is object:
        return value_count_object(values, dropna, mask=mask)

    elif htfunc_t is int8_t:
        return value_count_int8(values, dropna, mask=mask)
    elif htfunc_t is int16_t:
        return value_count_int16(values, dropna, mask=mask)
    elif htfunc_t is int32_t:
        return value_count_int32(values, dropna, mask=mask)
    elif htfunc_t is int64_t:
        return value_count_int64(values, dropna, mask=mask)

    elif htfunc_t is uint8_t:
        return value_count_uint8(values, dropna, mask=mask)
    elif htfunc_t is uint16_t:
        return value_count_uint16(values, dropna, mask=mask)
    elif htfunc_t is uint32_t:
        return value_count_uint32(values, dropna, mask=mask)
    elif htfunc_t is uint64_t:
        return value_count_uint64(values, dropna, mask=mask)

    elif htfunc_t is float64_t:
        return value_count_float64(values, dropna, mask=mask)
    elif htfunc_t is float32_t:
        return value_count_float32(values, dropna, mask=mask)

    elif htfunc_t is complex128_t:
        return value_count_complex128(values, dropna, mask=mask)
    elif htfunc_t is complex64_t:
        return value_count_complex64(values, dropna, mask=mask)

    else:
        raise TypeError(values.dtype)


cpdef duplicated(ndarray[htfunc_t] values, object keep="first", const uint8_t[:] mask=None):
    if htfunc_t is object:
        return duplicated_object(values, keep, mask=mask)

    elif htfunc_t is int8_t:
        return duplicated_int8(values, keep, mask=mask)
    elif htfunc_t is int16_t:
        return duplicated_int16(values, keep, mask=mask)
    elif htfunc_t is int32_t:
        return duplicated_int32(values, keep, mask=mask)
    elif htfunc_t is int64_t:
        return duplicated_int64(values, keep, mask=mask)

    elif htfunc_t is uint8_t:
        return duplicated_uint8(values, keep, mask=mask)
    elif htfunc_t is uint16_t:
        return duplicated_uint16(values, keep, mask=mask)
    elif htfunc_t is uint32_t:
        return duplicated_uint32(values, keep, mask=mask)
    elif htfunc_t is uint64_t:
        return duplicated_uint64(values, keep, mask=mask)

    elif htfunc_t is float64_t:
        return duplicated_float64(values, keep, mask=mask)
    elif htfunc_t is float32_t:
        return duplicated_float32(values, keep, mask=mask)

    elif htfunc_t is complex128_t:
        return duplicated_complex128(values, keep, mask=mask)
    elif htfunc_t is complex64_t:
        return duplicated_complex64(values, keep, mask=mask)

    else:
        raise TypeError(values.dtype)


cpdef ismember(ndarray[htfunc_t] arr, ndarray[htfunc_t] values):
    if htfunc_t is object:
        return ismember_object(arr, values)

    elif htfunc_t is int8_t:
        return ismember_int8(arr, values)
    elif htfunc_t is int16_t:
        return ismember_int16(arr, values)
    elif htfunc_t is int32_t:
        return ismember_int32(arr, values)
    elif htfunc_t is int64_t:
        return ismember_int64(arr, values)

    elif htfunc_t is uint8_t:
        return ismember_uint8(arr, values)
    elif htfunc_t is uint16_t:
        return ismember_uint16(arr, values)
    elif htfunc_t is uint32_t:
        return ismember_uint32(arr, values)
    elif htfunc_t is uint64_t:
        return ismember_uint64(arr, values)

    elif htfunc_t is float64_t:
        return ismember_float64(arr, values)
    elif htfunc_t is float32_t:
        return ismember_float32(arr, values)

    elif htfunc_t is complex128_t:
        return ismember_complex128(arr, values)
    elif htfunc_t is complex64_t:
        return ismember_complex64(arr, values)

    else:
        raise TypeError(values.dtype)


@cython.wraparound(False)
@cython.boundscheck(False)
def mode(ndarray[htfunc_t] values, bint dropna, const uint8_t[:] mask=None):
    # TODO(cython3): use const htfunct_t[:]

    cdef:
        ndarray[htfunc_t] keys
        ndarray[htfunc_t] modes
        ndarray[uint8_t] res_mask = None

        int64_t[::1] counts
        int64_t count, _, max_count = -1
        Py_ssize_t nkeys, k, na_counter, j = 0

    keys, counts, na_counter = value_count(values, dropna, mask=mask)
    nkeys = len(keys)

    modes = np.empty(nkeys, dtype=values.dtype)

    with nogil(htfunc_t is not object):
        for k in range(nkeys):
            count = counts[k]
            if count == max_count:
                j += 1
            elif count > max_count:
                max_count = count
                j = 0
            else:
                continue

            modes[j] = keys[k]

    if na_counter > 0:
        res_mask = np.zeros(j+1, dtype=np.bool_)
        res_mask[j] = (na_counter == max_count)
    return modes[:j + 1], res_mask


